[gd_resource type="Theme" format=3]

[ext_resource type="FontVariation" path="res://theme_dev/themes_raw/Aurora/assets/font_regular.tres" id="1_font"]
[ext_resource type="FontVariation" path="res://theme_dev/themes_raw/Aurora/assets/font_semibold.tres" id="2_semibold"]

; Aurora's look for Songo's own controls: navy pills and panels, white
; Montserrat text, and the indigo accent on whatever has focus. List rows
; are full pills, 46 pixels tall and 2 apart, as in Aurora's lists.
;
; CollectionOptions' list_bottom_fade and ListSectionOuterMargin's
; margin_bottom go together: the margin leaves room below the list as tall
; as the fade, so the list's end (and the bar under it) sits above the fade
; rather than inside it. Change one, change the other to match.

